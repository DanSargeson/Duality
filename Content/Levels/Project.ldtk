							"__worldY": 416
						},
						{
							"__identifier": "Document",
							"__grid": [26,4],
							"__pivot": [0,0],
							"__tags": ["TEXT"],
							"__tile": null,
							"__smartColor": "#2CE8F5",
							"iid": "d2291bc0-48b0-11f1-960d-b509448b1cb9",
							"width": 16,
							"height": 32,
							"defUid": 64,
							"px": [416,64],
							"fieldInstances": [
								{ "__identifier": "TextContent", "__type": "String", "__value": "[ CONTAINMENT_ALERT_04.sys ]\nWARNING: UNAUTHORIZED FREQUENCY MODULATION\n\nNOTES: Subject has bypassed localized frequency locks. They are voluntarily inducing hypoxic trauma to ascend into the Insight frequency [ RIGHT SHIFT ], before instinctively grounding themselves back into the ignorance of baseline Density [ LEFT SHIFT ].\n\nPROTOCOL: The human biological suit is not designed to sustain the truth of Insight. Extended exposure will result in critical system strain and catastrophic cognitive fracture. Do not intervene when they retreat to Density. The desperate oscillation between revelation and safety generates optimal telemetry. Let them look, but they cannot linger.", "__tile": null, "defUid": 66, "realEditorValues": [{
									"id": "V_String",
									"params": [
										"[ CONTAINMENT_ALERT_04.sys ]\\nWARNING: UNAUTHORIZED FREQUENCY MODULATION\\n\\nNOTES: Subject has bypassed localized frequency locks. They are voluntarily inducing hypoxic trauma to ascend into the Insight frequency [ RIGHT SHIFT ], before instinctively grounding themselves back into the ignorance of baseline Density [ LEFT SHIFT ].\\n\\nPROTOCOL: The human biological suit is not designed to sustain the truth of Insight. Extended exposure will result in critical system strain and catastrophic cognitive fracture. Do not intervene when they retreat to Density. The desperate oscillation between revelation and safety generates optimal telemetry. Let them look, but they cannot linger."
									]
								}] },
								{ "__identifier": "AnchorFrequency", "__type": "Float", "__value": 0, "__tile": null, "defUid": 67, "realEditorValues": [] },
