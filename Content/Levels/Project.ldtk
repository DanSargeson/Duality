							"px": [752,416],
							"fieldInstances": [
								{ "__identifier": "ColourHex", "__type": "Color", "__value": "#FFD700", "__tile": null, "defUid": 42, "realEditorValues": [] },
								{ "__identifier": "NextLevel", "__type": "String", "__value": "Level_1", "__tile": null, "defUid": 43, "realEditorValues": [{
									"id": "V_String",
