			"fieldInstances": [{ "__identifier": "OnLoadLog", "__type": "String", "__value": "[ DIAGNOSTIC_LOG_01.sys ]\nSUBJECT: 8144-M\nTEST: Motor Function & Environmental Engagement\n\nOBSERVATION: Subject has regained consciousness. Motor functions appear intact. Subject is capable of autonomous navigation [ W A S D ] and physical interaction with containment terminals [ E ].\n\nACTION: Proceed with baseline environmental stimuli. Monitor for signs of cognitive fracture.", "__tile": null, "defUid": 97, "realEditorValues": [{
