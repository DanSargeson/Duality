						{
							"__identifier": "Document",
							"__grid": [44,3],
							"__pivot": [0,0],
							"__tags": ["TEXT"],
							"__tile": null,
							"__smartColor": "#2CE8F5",
							"iid": "7cd082c0-6fc0-11f1-adf8-cb6288c0aa90",
							"width": 32,
							"height": 16,
							"defUid": 64,
							"px": [704,48],
							"fieldInstances": [
								{ "__identifier": "TextContent", "__type": "String", "__value": " [ SYSTEM_OVERRIDE_PROTOCOL.sys ]\nSUBJECT: 8144-M\nTEST: Electro-Neural Grounding\n\nOBSERVATION: In the event of acute systemic strain, the subject has discovered they can trigger a localised electrostatic purge [ SPACEBAR ].\n\nACTION: Allow this behaviour. While the purge temporarily disrupts local surveillance geometry, it violently grounds the subject back to Density and induces a mandatory exhaustion period. The pain generated by this action provides excellent yield.", "__tile": null, "defUid": 66, "realEditorValues": [{
									"id": "V_String",
									"params": [
										" [ SYSTEM_OVERRIDE_PROTOCOL.sys ]\\nSUBJECT: 8144-M\\nTEST: Electro-Neural Grounding\\n\\nOBSERVATION: In the event of acute systemic strain, the subject has discovered they can trigger a localised electrostatic purge [ SPACEBAR ].\\n\\nACTION: Allow this behaviour. While the purge temporarily disrupts local surveillance geometry, it violently grounds the subject back to Density and induces a mandatory exhaustion period. The pain generated by this action provides excellent yield."
									]
								}] },
								{ "__identifier": "AnchorFrequency", "__type": "Float", "__value": 0, "__tile": null, "defUid": 67, "realEditorValues": [] },
								{ "__identifier": "Range", "__type": "Float", "__value": 100, "__tile": null, "defUid": 68, "realEditorValues": [] },
								{ "__identifier": "ColourHex", "__type": "Color", "__value": "#2CE8F5", "__tile": null, "defUid": 70, "realEditorValues": [] }
							],
							"__worldX": 688,
